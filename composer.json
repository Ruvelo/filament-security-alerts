{
    "name": "ruvelo/filament-security-alerts",
    "description": "Your Laravel app's vulnerable dependencies inside Filament: a findings table with exploited-in-the-wild flaws first, a one-click check, a dashboard widget and a navigation badge.",
    "keywords": [
        "laravel",
        "filament",
        "filament-plugin",
        "security",
        "vulnerabilities",
        "advisories",
        "composer-audit",
        "cisa-kev"
    ],
    "license": "MIT",
    "type": "library",
    "homepage": "https://ruvelo.github.io/filament-security-alerts/",
    "authors": [
        {
            "name": "François Bultez",
            "homepage": "https://github.com/francoisbultez",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^4.0|^5.0",
        "laravel/framework": "^12.4.1|^13.0",
        "ruvelo/laravel-security-alerts": "^2.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Ruvelo\\FilamentSecurityAlerts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ruvelo\\FilamentSecurityAlerts\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ruvelo\\FilamentSecurityAlerts\\FilamentSecurityAlertsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ],
        "demo": "php demo/build.php build/site && cp -r art build/site/art && echo 'Serve it: php -S 127.0.0.1:8000 -t build/site'"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "support": {
        "issues": "https://github.com/Ruvelo/filament-security-alerts/issues",
        "source": "https://github.com/Ruvelo/filament-security-alerts"
    },
    "scripts-descriptions": {
        "test": "Run the test suite",
        "lint": "Check code style",
        "format": "Fix code style",
        "analyse": "Run static analysis",
        "check": "Lint, analyse and test: what CI runs",
        "demo": "Build the screenshot gallery into build/"
    }
}
